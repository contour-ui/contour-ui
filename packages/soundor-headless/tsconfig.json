  "extends": "@contour-ui/typescript-config/library-soundor.json",
  "compilerOptions": {
    // Soundor's modules and Web globals, in place of the DOM.
    "types": ["@soundor/environment"]
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.lib.json" },
    { "path": "./tsconfig.test.json" },
    { "path": "./tsconfig.config.json" }
  ]
}
