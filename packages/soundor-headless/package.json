{
  "name": "@contour-ui/soundor-headless",
  "version": "0.0.0",
  "description": "contour-ui unstyled components for Soundor plugin UIs: the machines of @contour-ui/core on @soundor/react.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contour-ui/contour-ui.git",
    "directory": "packages/soundor-headless"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@contour-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@contour-ui/core": "workspace:*"
  },
  "devDependencies": {
    "@contour-ui/typescript-config": "workspace:*",
    "@contour-ui/vite-config": "workspace:*",
    "@soundor/environment": "catalog:",
    "@soundor/react": "catalog:",
    "@soundor/testing-library": "catalog:",
    "@soundor/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-environment-soundor": "catalog:"
  },
  "peerDependencies": {
    "@soundor/react": "^0.15.0",
    "react": "^19.3.0"
  }
}
