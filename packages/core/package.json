{
  "name": "@contour-ui/core",
  "version": "0.0.0",
  "description": "contour-ui core: framework- and renderer-agnostic UI logic.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contour-ui/contour-ui.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@contour-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "@contour-ui/source": "./src/react/index.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "devDependencies": {
    "@contour-ui/typescript-config": "workspace:*",
    "@contour-ui/vite-config": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
