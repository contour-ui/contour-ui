{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "base": {
    "font-family": {
      "$type": "fontFamily",
      "$description": "Same pairing as Even: IBM Plex Sans for text, JetBrains Mono for every number. Both OFL; embed the font files in plugins.",
      "ui":   { "$value": ["IBM Plex Sans", "system-ui", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "font-weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "font-size": {
      "$type": "dimension",
      "$description": "Plugin UI text is 10-14 px; long-form reading and page headings start at 15 px.",
      "10": { "$value": { "value": 10, "unit": "px" } },
      "11": { "$value": { "value": 11, "unit": "px" } },
      "12": { "$value": { "value": 12, "unit": "px" } },
      "13": { "$value": { "value": 13, "unit": "px" } },
      "14": { "$value": { "value": 14, "unit": "px" } },
      "15": { "$value": { "value": 15, "unit": "px" } },
      "16": { "$value": { "value": 16, "unit": "px" } },
      "18": { "$value": { "value": 18, "unit": "px" } },
      "20": { "$value": { "value": 20, "unit": "px" } },
      "24": { "$value": { "value": 24, "unit": "px" } },
      "30": { "$value": { "value": 30, "unit": "px" } }
    },
    "line-height": {
      "$type": "number",
      "tight":  { "$value": 1.2 },
      "normal": { "$value": 1.4 },
      "loose":  { "$value": 1.6 }
    },
    "letter-spacing": {
      "$type": "dimension",
      "normal": { "$value": { "value": 0, "unit": "px" } },
      "wide":   { "$value": { "value": 0.5, "unit": "px" } }
    }
  }
}
