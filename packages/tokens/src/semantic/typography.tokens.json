{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "text": {
    "$type": "typography",
    "heading": {
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.14}",
        "fontWeight": "{base.font-weight.semibold}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "body": {
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.13}",
        "fontWeight": "{base.font-weight.regular}",
        "lineHeight": "{base.line-height.normal}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "label": {
      "$description": "Control labels: Gain, Freq, Q.",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.11}",
        "fontWeight": "{base.font-weight.medium}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.wide}"
      }
    },
    "label-lg": {
      "$description": "Labels of lg controls, such as lg buttons. Body-sized, so without the letter spacing that small labels need.",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.13}",
        "fontWeight": "{base.font-weight.medium}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "value": {
      "$description": "Numeric readouts: -6.0 dB, 1.2 kHz. Monospace so digits do not shift while the value changes.",
      "$value": {
        "fontFamily": "{base.font-family.mono}",
        "fontSize": "{base.font-size.12}",
        "fontWeight": "{base.font-weight.regular}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "caption": {
      "$description": "Units, tick marks, scale labels.",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.10}",
        "fontWeight": "{base.font-weight.regular}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "display": {
      "$description": "Page title of long-form pages such as docs (h1).",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.30}",
        "fontWeight": "{base.font-weight.semibold}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "title": {
      "$description": "Section heading of long-form pages (h2).",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.24}",
        "fontWeight": "{base.font-weight.semibold}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "subtitle": {
      "$description": "Subsection heading of long-form pages (h3).",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.18}",
        "fontWeight": "{base.font-weight.semibold}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "prose": {
      "$description": "Long-form reading: docs paragraphs and lists.",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.15}",
        "fontWeight": "{base.font-weight.regular}",
        "lineHeight": "{base.line-height.loose}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "code": {
      "$description": "Code in running text and in code blocks. Same line height as body, so inline code never spreads its lines.",
      "$value": {
        "fontFamily": "{base.font-family.mono}",
        "fontSize": "{base.font-size.13}",
        "fontWeight": "{base.font-weight.regular}",
        "lineHeight": "{base.line-height.normal}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "hero": {
      "$description": "Hero title of a site page such as a home page (h1): larger than display, with tighter lines and letter spacing.",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.60}",
        "fontWeight": "{base.font-weight.semibold}",
        "lineHeight": "{base.line-height.tighter}",
        "letterSpacing": "{base.letter-spacing.tight}"
      }
    },
    "lead": {
      "$description": "Lead paragraph under a hero title.",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.16}",
        "fontWeight": "{base.font-weight.regular}",
        "lineHeight": "{base.line-height.loose}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    },
    "nav": {
      "$description": "Navigation links in a site header.",
      "$value": {
        "fontFamily": "{base.font-family.ui}",
        "fontSize": "{base.font-size.15}",
        "fontWeight": "{base.font-weight.medium}",
        "lineHeight": "{base.line-height.tight}",
        "letterSpacing": "{base.letter-spacing.normal}"
      }
    }
  }
}
