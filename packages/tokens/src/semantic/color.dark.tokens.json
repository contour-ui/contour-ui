{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{base.color.neutral.975}",
        "$description": "Plugin window background, the lowest layer."
      },
      "surface": {
        "$value": "{base.color.neutral.950}",
        "$description": "Panels and sections placed on the canvas."
      },
      "raised": {
        "$value": "{base.color.neutral.900}",
        "$description": "Menus, popovers, tooltips."
      },
      "inset": {
        "$value": "{base.color.neutral.975}",
        "$description": "Recessed wells: knob and slider tracks, meter backgrounds, displays."
      },
      "hover": {
        "$value": "{base.color.neutral.800}"
      }
    },
    "fg": {
      "default": {
        "$value": "{base.color.neutral.50}"
      },
      "muted": {
        "$value": "{base.color.neutral.300}"
      },
      "subtle": {
        "$value": "{base.color.neutral.400}",
        "$description": "Units, tick labels, secondary metadata."
      },
      "disabled": {
        "$value": "{base.color.neutral.600}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{base.color.neutral.900}"
      },
      "default": {
        "$value": "{base.color.neutral.800}"
      },
      "strong": {
        "$value": "{base.color.neutral.600}"
      },
      "focus": {
        "$value": "{base.color.blue.400}"
      }
    },
    "accent": {
      "fill": {
        "$value": "{base.color.blue.400}"
      },
      "fill-hover": {
        "$value": "{base.color.blue.300}"
      },
      "on-fill": {
        "$value": "{base.color.neutral.975}",
        "$description": "Text and icons placed on accent.fill."
      },
      "fg": {
        "$value": "{base.color.blue.300}"
      },
      "bg": {
        "$value": "{base.color.blue.900}"
      },
      "border": {
        "$value": "{base.color.blue.600}"
      }
    },
    "danger": {
      "fill": {
        "$value": "{base.color.red.400}"
      },
      "fill-hover": {
        "$value": "{base.color.red.300}"
      },
      "on-fill": {
        "$value": "{base.color.neutral.975}"
      },
      "fg": {
        "$value": "{base.color.red.300}"
      },
      "bg": {
        "$value": "{base.color.red.900}"
      },
      "border": {
        "$value": "{base.color.red.600}"
      }
    },
    "success": {
      "fill": {
        "$value": "{base.color.green.400}"
      },
      "fill-hover": {
        "$value": "{base.color.green.300}"
      },
      "on-fill": {
        "$value": "{base.color.neutral.975}"
      },
      "fg": {
        "$value": "{base.color.green.300}"
      },
      "bg": {
        "$value": "{base.color.green.900}"
      },
      "border": {
        "$value": "{base.color.green.600}"
      }
    },
    "warning": {
      "fill": {
        "$value": "{base.color.yellow.400}"
      },
      "fill-hover": {
        "$value": "{base.color.yellow.300}"
      },
      "on-fill": {
        "$value": "{base.color.neutral.975}"
      },
      "fg": {
        "$value": "{base.color.yellow.300}"
      },
      "bg": {
        "$value": "{base.color.yellow.900}"
      },
      "border": {
        "$value": "{base.color.yellow.600}"
      }
    },
    "overlay": {
      "scrim": {
        "$value": {
          "colorSpace": "oklch",
          "components": [
            0.165,
            0.008,
            255
          ],
          "alpha": 0.6,
          "hex": "#0c0f12"
        },
        "$description": "Translucent backdrop behind dialogs and drawers."
      }
    },
    "syntax": {
      "constant": {
        "$value": "{base.color.orange.300}",
        "$description": "Numbers, language constants, constant and object names, CSS properties."
      },
      "string": {
        "$value": "{base.color.yellow.300}",
        "$description": "Unquoted strings: shell arguments, Markdown code."
      },
      "comment": {
        "$value": "{base.color.neutral.400}",
        "$description": "Comments."
      },
      "keyword": {
        "$value": "{base.color.violet.300}",
        "$description": "Keywords and storage modifiers, JSON keys."
      },
      "parameter": {
        "$value": "{base.color.red.300}",
        "$description": "Function parameters."
      },
      "function": {
        "$value": "{base.color.blue.300}",
        "$description": "Functions, types and classes, JSX and HTML attributes."
      },
      "string-expression": {
        "$value": "{base.color.green.300}",
        "$description": "Quoted and template strings, regular expressions, tag names."
      },
      "punctuation": {
        "$value": "{base.color.neutral.300}",
        "$description": "Separators and argument punctuation."
      },
      "link": {
        "$value": "{base.color.cyan.300}",
        "$description": "Links in Markdown."
      }
    }
  }
}
