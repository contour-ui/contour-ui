    { "foreground": "color.fg.subtle", "background": "color.bg.surface", "minimum": 3 },
    { "foreground": "color.fg.subtle", "background": "color.bg.inset", "minimum": 3 },
    { "foreground": "color.fg.disabled", "background": "color.bg.surface", "minimum": null },
