{
  "name": "@contour-ui/tokens",
  "version": "0.0.0",
  "description": "contour-ui design tokens: DTCG sources compiled into CSS custom properties, typed TS references, token data and the values Soundor styles take.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contour-ui/contour-ui.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/tokens.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./soundor": {
      "types": "./dist/soundor.d.ts",
      "default": "./dist/soundor.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./docs.json": "./dist/docs.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./soundor": {
        "types": "./dist/soundor.d.ts",
        "default": "./dist/soundor.js"
      },
      "./tokens.css": "./dist/tokens.css",
      "./docs.json": "./dist/docs.json",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "design-system": "node scripts/design-system.ts"
  },
  "devDependencies": {
    "@contour-ui/tokens-compiler": "workspace:*",
    "@contour-ui/typescript-config": "workspace:*",
    "@contour-ui/vite-config": "workspace:*",
    "@types/culori": "catalog:",
    "culori": "catalog:",
    "vite-plus": "catalog:"
  }
}
