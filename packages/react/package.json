{
  "name": "@contour-ui/react",
  "version": "0.0.0",
  "description": "contour-ui for React: styled components, everyday (Essentials) and for audio interfaces (Audio), on the web (React DOM) and in Soundor plugin UIs (@soundor/react).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contour-ui/contour-ui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./src/**/*.css"
  ],
  "imports": {
    "#platform/*": {
      "@contour-ui/source": {
        "soundor": "./src/platform/*.soundor.ts",
        "default": "./src/platform/*.web.ts"
      },
      "types": {
        "soundor": "./dist/platform/*.soundor.d.ts",
        "default": "./dist/platform/*.web.d.ts"
      },
      "soundor": "./dist/platform/*.soundor.js",
      "default": "./dist/platform/*.web.js"
    }
  },
  "exports": {
    ".": {
      "@contour-ui/source": {
        "soundor": "./src/index.soundor.ts",
        "default": "./src/index.ts"
      },
      "types": {
        "soundor": "./dist/index.soundor.d.ts",
        "default": "./dist/index.d.ts"
      },
      "soundor": "./dist/index.soundor.js",
      "default": "./dist/index.js"
    },
    "./theme-script": {
      "@contour-ui/source": "./src/theme-provider/theme-script.ts",
      "types": "./dist/theme-script.d.ts",
      "default": "./dist/theme-script.js"
    },
    "./styles.css": {
      "@contour-ui/source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": {
          "soundor": "./dist/index.soundor.d.ts",
          "default": "./dist/index.d.ts"
        },
        "soundor": "./dist/index.soundor.js",
        "default": "./dist/index.js"
      },
      "./theme-script": {
        "types": "./dist/theme-script.d.ts",
        "default": "./dist/theme-script.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@contour-ui/fonts": "workspace:*",
    "@contour-ui/headless-react": "workspace:*",
    "@contour-ui/icons": "workspace:*",
    "@contour-ui/primitive": "workspace:*",
    "@contour-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@contour-ui/test-harness": "workspace:*",
    "@contour-ui/typescript-config": "workspace:*",
    "@contour-ui/vite-config": "workspace:*",
    "@soundor/environment": "catalog:",
    "@soundor/react": "catalog:",
    "@soundor/testing-library": "catalog:",
    "@soundor/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:",
    "vitest-environment-soundor": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  }
}
