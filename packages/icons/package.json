{
  "name": "@contour-ui/icons",
  "version": "0.0.0",
  "description": "contour-ui icons: Lucide icons and brand logos as normalized path data for SVG and Canvas 2D, plus drawIcon.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contour-ui/contour-ui.git",
    "directory": "packages/icons"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@contour-ui/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "icons": "node scripts/build.ts"
  },
  "devDependencies": {
    "@contour-ui/typescript-config": "workspace:*",
    "@contour-ui/vite-config": "workspace:*",
    "lucide-static": "catalog:",
    "simple-icons": "catalog:",
    "svgpath": "catalog:",
    "vite-plus": "catalog:"
  }
}
