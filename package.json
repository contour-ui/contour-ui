{
  "name": "contour-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "contour-ui design system monorepo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contour-ui/contour-ui.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "ready": "vp check && vp run boundaries && vp test && vp run -r build",
    "storybook": "vp run -r --parallel storybook",
    "changeset": "changeset",
    "version-packages": "changeset version && vp fmt",
    "release": "vp run -r --filter './packages/*' build && changeset publish",
    "build-storybook": "vp run @contour-ui/app-storybook#build-storybook",
    "visual": "node scripts/visual.ts",
    "visual:update": "node scripts/visual.ts --update",
    "visual:ci": "node scripts/visual.ts --ci"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/cli": "catalog:",
    "@contour-ui/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.15.0"
}
