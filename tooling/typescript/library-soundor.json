{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "contour-ui Soundor library (no DOM)",
  "extends": "./library.json",
  "compilerOptions": {
    // Soundor runs ES2023 with its own modules and a subset of the Web globals, without a DOM:
    // the package lists `@soundor/environment` in `types`, so `window` or `document` fail to
    // compile instead of failing in a plugin.
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    // The Soundor build of every workspace package that has one (`@contour-ui/primitive` and the
    // packages above it): an app's bundler picks it by the same condition.
    "customConditions": ["@contour-ui/source", "soundor"]
  }
}
