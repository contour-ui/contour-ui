# Read only by pnpm <= 10 (pnpm 11+ takes settings from pnpm-workspace.yaml,
# where `pmOnFail: ignore` does the same and this key is rejected).
# Stops old pnpm from silently switching to the pinned `packageManager` version,
# so it fails fast on `engines.pnpm: ">=12"` instead.
manage-package-manager-versions=false
